# ─────────────────────────────────────────────────────────────────────────────
# CivicAI — Environment Configuration
# Copy this file to .env and fill in your values.
# All external services are OPTIONAL — the app runs fully on mocks when absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
# Set to 'true' during local development only.
# In production this MUST be 'false'.
DEBUG=true

# Show /docs and /redoc interactive API docs. Set to 'false' in production.
DOCS_ENABLED=true

# ── Vision AI (for image analysis — leave empty for deterministic mock) ──────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=8

# ── Security (production only) ────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Example: ALLOWED_ORIGINS=https://civicai.amc.gov.in
# Leave empty in debug mode — wildcard CORS is used automatically.
ALLOWED_ORIGINS=
