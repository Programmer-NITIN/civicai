{
  "version": 2,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/complaint/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/status/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/directory/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/docs",
      "destination": "/api/index"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index"
    },
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ]
}
